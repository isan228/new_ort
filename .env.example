PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ort_2026
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@ort.kg
ADMIN_PASSWORD=admin123

# Суперпользователь Postgres — только для npm run setup:db, если DATABASE_URL не postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Finik: только эти два поля. Ключи — файлы в корне: finik_private.pem и finik_public.pem
# Домен, вебхук и возврат зашиты: https://ort.kg
FINIK_API_KEY=
FINIK_ACCOUNT_ID=

# Student Bot. Токен — от @BotFather. Без токена бот выключен.
TELEGRAM_BOT_TOKEN=
# Telegram ID администраторов через запятую — только им доступна команда /admin в боте
SB_ADMIN_IDS=
# Локально без публичного адреса: true — бот сам опрашивает Telegram
TELEGRAM_POLLING=
